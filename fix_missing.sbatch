#!/bin/bash
#SBATCH -J fix_missing
#SBATCH -o %x_logs/%x_%j.log
#SBATCH -p epyc-64
#SBATCH --time=01:00:00
#SBATCH --mem=16g
#SBATCH --cpus-per-task=12

# Script variables
# Extract job name from script
if [[ -z "${SLURM_JOB_NAME}" ]]
then
  job_name="$(basename "$0")"
  job_name="${job_name%%.*}"
else
  job_name="$SLURM_JOB_NAME"
fi

# Help message
show_help () {
  echo "\
Fixes VCF files generated by GATK4 (v4.2.3.0-v4.5.0.0) that did not mark all
missing sites with '.'.

Usage: sbatch $job_name.sbatch <in_vcf> 
  <in_vcf>   indexed input VCF file

Output:
  .
  ├── <in_vcf>.fix.vcf.gz                             # missing GT-corrected VCF
  └── <in_vcf>.fix.vcf.gz.csi                                 # output VCF index

Requires:
  - BCFtools (https://www.htslib.org/)"
}
if [[ $1 == "-h" || $1 == "--help" ]]
then
  show_help
  exit 0
elif [[ "$#" -ne 1 ]]
then
  echo "Error: 1 positional argument required."
  echo
  show_help
  exit 1
fi

# -e  exit on error
# -o pipefail  catch errors in pipes
set -eo pipefail

# Print date and time
date
echo

# Load conda
cond=~/.conda_for_sbatch.sh
if [[ -f "$cond" ]]
then
  source "$cond"
else
  echo "Error on source of $cond"
  exit 1
fi

# Multithread support
if [[ -n "$SLURM_CPUS_PER_TASK" ]]
then
  nthrd="$SLURM_CPUS_PER_TASK"
else
  nthrd="1"
fi

# Load BCFtools
module purge
conda activate bcftools
bcftools --version || exit 1
echo

# Input
# VCF file
# in_vcf="master_2026_SlaSLCT1FG3_1_AssemblyScaffolds_Repeatmasked.vcf.gz"
in_vcf="$1"
# Check input VCF exists
if [[ -f "$in_vcf" ]]
then
  echo "Input VCF: $in_vcf"
  # Verify input VCF is indexed
  if [[ -f "$in_vcf.tbi" ]]
  then
    in_idx="$in_vcf.tbi"
  elif [[ -f "$in_vcf.csi" ]]
  then
    in_idx="$in_vcf.csi"
  else
    in_idx="$in_vcf.csi"
    echo "No index found. Creating VCF index..."
    # Index output VCFs
    set -x
    # bcftools index "$in_vcf"
    set +x
  fi
  echo "Index found for VCF: $in_idx"
else
  echo "Error: Input VCF file ($in_vcf) not found."
  exit 1
fi
echo

# Output
# Extract name from input
vcf_basename="$(basename "$in_vcf")"
vcf_base="${vcf_basename%%.vcf.*}"
out_vcf="$vcf_base.fix.vcf.gz" # missing GT-corrected VCF
out_idx="$out_vcf.csi" # output VCF index (default format: CSI)

# Copy to TMPDIR
set -x
rsync -ah --info=progress2 "$in_vcf" "$in_idx" "$TMPDIR/"
set +x

# Change GT from 0 to . when DP = 0 with bcftools setGT
set -x
bcftools +setGT --threads "$nthrd" \
  -W -Oz -o "$TMPDIR/$out_vcf" "$TMPDIR/$in_vcf" \
  -- --target-gt q --new-gt "." --include 'FMT/DP=0'
set +x

# Copy output out of TMPDIR
set -x
rsync -ah --info=progress2 "$TMPDIR/$out_vcf" "$TMPDIR/$out_idx" .
set +x

# Done
echo
echo "Finished at: $(date)"
