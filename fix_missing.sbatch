#!/bin/bash
#SBATCH -J fix_missing
#SBATCH -o %x_logs/%x_%j.log
#SBATCH -p epyc-64
#SBATCH --time=01:00:00
#SBATCH --mem=16g
#SBATCH --cpus-per-task=12

# Script variables
# Extract job name from script
if [[ -z "$SLURM_JOB_NAME" ]]
then
  job_name="$(basename "$0")"
  job_name="${job_name%%.*}"
else
  job_name="$SLURM_JOB_NAME"
fi
scripts_dir="s-latissima-mutation-annotation/" # scripts directory
# By default looks in scripts_dir then current directory for "mut_annot.config"
config_def="mut_annot.config"
# Set Java memory from Slurm resources, if available
mem="${SLURM_MEM_PER_NODE:-"9638"}" # unit = MiB
mem="$(( 85 * mem / 100 ))m" # only use 85% of available (default = 8GiB)

# Help message
show_help () {
  echo "\
Fixes VCF files generated by GATK4 (v4.2.3.0-v4.5.0.0) that did not mark all
missing sites with '.'.

Usage: sbatch $job_name.sbatch [config_file]
  config_file    (optional) provide config file if default config ($config_def)
                 does not exist in either scripts_dir ($scripts_dir)
                 or current directory (./)

Output:
  .
  ├── <vcf>.fix.vcf.gz                         # output missing GT-corrected VCF
  └── <vcf>.fix.vcf.gz.tbi                     # output VCF index

Requires:
  - BCFtools (https://www.htslib.org/)"
}
if [[ $1 == "-h" || $1 == "--help" ]]
then
  show_help
  exit 0
elif [[ "$#" -ne 1 ]]
then
  echo "Error: 1 positional argument required."
  echo
  show_help
  exit 1
fi

# Print date and time
date
echo

# Source configuration file
# If scripts_dir exists, look there first
[[ -d "$scripts_dir" ]] && config_def="$scripts_dir/$config_def"
config_file="${1:-"$config_def"}"
if [[ -f "$config_file" ]]
then
	source "$config_file"
else
	echo "Error: Config file ($config_file) not found."
	exit 1
fi

# Load conda
module purge
if [[ -f "$cond" ]]
then
  source "$cond"
else
  echo "Error on source of $cond"
  exit 1
fi

# Multithread support
if [[ -n "$SLURM_CPUS_PER_TASK" ]]
then
  nthrd="$SLURM_CPUS_PER_TASK"
else
  nthrd="1"
fi

# Load BCFtools
conda activate bcftools
bcftools --version || exit 1
echo

# Input
# VCF file
# vcf_basename="master_2026_SlaSLCT1FG3_1_AssemblyScaffolds_Repeatmasked.vcf.gz"
# vcf_idx="$vcf_basename.tbi"
vcf_basename="$1"
# Check input VCF exists
if [[ -f "$vcf_basename" ]]
then
  echo "Input VCF: $vcf_basename"
  # Verify input VCF is indexed
  if [[ ! -f "$vcf_idx" ]] # check for existing TBI index
  then
    echo "No index found. Creating VCF index..."
    set -x
    bcftools index --tbi --threads "$nthrd" "$vcf_basename"
    set +x
  fi
  echo "VCF index: $vcf_idx"
else
  echo "Error: Input VCF file ($vcf_basename) not found."
  exit 1
fi
echo

# Output
out_vcf="$vcf_base.fix.vcf.gz" # missing GT-corrected VCF
out_idx="$out_vcf.tbi" # output VCF index (format: TBI)

# Copy to TMPDIR
set -x
rsync -ah --info=progress2 "$vcf_basename" "$vcf_idx" "$TMPDIR/"
set +x

# Change GT from 0 to . when DP = 0 with bcftools setGT
set -x
bcftools +setGT --threads "$nthrd" \
  -W="tbi" -Oz -o "$TMPDIR/$out_vcf" "$TMPDIR/$vcf" \
  -- --target-gt q --new-gt "." --include 'FMT/DP=0'
set +x

# Copy output out of TMPDIR
set -x
rsync -ah --info=progress2 "$TMPDIR/$out_vcf" "$TMPDIR/$out_idx" .
set +x

# Done
echo
echo "Finished at: $(date)"
